extends Node2D
class_name PowerUp

enum PowerUpType {
	INDUSTRIAL_BOOST, BERRY_BURST, THUNDER_DASH, ENERGY_SURGE
}

@export var powerup_type: PowerUpType = PowerUpType.INDUSTRIAL_BOOST
@export var duration: float = 15.0
@export var icon_texture: Texture2D  # Assign icons here

@onready var sprite = $PickupArea/Sprite2D
@onready var timer = $PickupArea/Timer

func _ready():
	# Set icon from exported texture (set in editor)
	if icon_texture:
		sprite.texture = icon_texture
	else:
		# Fallback colors (if no texture)
		match powerup_type:
			PowerUpType.INDUSTRIAL_BOOST: sprite.modulate = Color.YELLOW
			PowerUpType.BERRY_BURST: sprite.modulate = Color.RED
			PowerUpType.THUNDER_DASH: sprite.modulate = Color.YELLOW
			PowerUpType.ENERGY_SURGE: sprite.modulate = Color.ORANGE
	
	# Bob animation
	var tween = create_tween()
	tween.set_loops()
	#tween.tween_property(self, "position.y", -8, 1.0).set_trans(Tween.TRANS_SINE)
	#tween.tween_property(self, "position.y", 0, 1.0).set_trans(Tween.TRANS_SINE)
	
	# Connect signals
	$PickupArea.body_entered.connect(_pickup)
	timer.timeout.connect(queue_free)
	timer.start(30)

func _pickup(body):
	print("zehahah  ", body.get_groups())
	if body.is_in_group("player"):
		body.apply_powerup(powerup_type, duration)
		queue_free()
